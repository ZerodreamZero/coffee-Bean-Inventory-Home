    function updateHomeStats() {
      document.getElementById('home-stat-beans').textContent = `${beans.length} 款`;
      document.getElementById('home-stat-brews').textContent = `${brews.length} 次`;
      document.getElementById('home-stat-gears').textContent = `${gears.length} 件`;

      const container = document.getElementById('home-recent-brews-container');
      if (brews.length === 0) {
        container.innerHTML = `<div class="bg-white border border-pinkapp-200 rounded-3xl p-4 text-center text-xs text-pinkapp-400 font-medium">尚未有沖煮紀錄 ✨</div>`;
