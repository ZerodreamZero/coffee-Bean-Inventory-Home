      if (activeBtn) activeBtn.className = "bean-filter-pill active bg-pinkapp-600 text-white px-3 py-1 rounded-xl font-bold text-[11px] transition-all";
      renderBeansList();
    }

    // --- BEANS LIST & CONFIRMATION FIX ---
    function renderBeansList() {
      const container = document.getElementById('beans-list-container');
      if (!container) return;
      const searchInput = document.getElementById('bean-search-input');
      const search = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const sort = document.getElementById('bean-sort-select').value;

      let filtered = beans.filter(b => {
        const matchesSearch = b.name.toLowerCase().includes(search) || 
                              (b.origin && b.origin.toLowerCase().includes(search)) || 
                              (b.roaster && b.roaster.toLowerCase().includes(search)) ||
                              (b.notes && b.notes.toLowerCase().includes(search));
        let matchesRoast = true;
        if (beanFilter === 'LIGHT') matchesRoast = b.roast.includes('淺');
        else if (beanFilter === 'MEDIUM') matchesRoast = b.roast.includes('中');
        else if (beanFilter === 'DARK') matchesRoast = b.roast.includes('深');

        return matchesSearch && matchesRoast;
      });

      if (sort === 'weight-desc') filtered.sort((a,b) => b.weight - a.weight);
      else if (sort === 'weight-asc') filtered.sort((a,b) => a.weight - b.weight);

      document.getElementById('stat-bean-count').textContent = `${beans.length} 款`;
      document.getElementById('stat-bean-weight').textContent = `${beans.reduce((acc,cur)=>acc+Number(cur.weight||0),0)} g`;
      const uniqueRoasters = new Set(beans.map(b=>b.roaster).filter(Boolean));
      document.getElementById('stat-bean-roasters').textContent = `${uniqueRoasters.size} 家`;

      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white border border-pinkapp-200 rounded-3xl p-6 text-center text-xs text-pinkapp-400">未找到符合條件的咖啡豆 🌸</div>`;
        return;
      }

      container.innerHTML = filtered.map(b => `
        <div class="bg-white border border-pinkapp-200/80 rounded-3xl p-4 shadow-soft-card space-y-2.5 relative">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-[9px] font-black uppercase tracking-wider text-pinkapp-500 bg-pinkapp-100 px-2 py-0.5 rounded-md">${b.roast}</span>
              <h3 class="text-sm font-bold font-title text-pinkapp-900 mt-1">${b.name}</h3>
              <p class="text-[11px] text-pinkapp-600/80 font-medium">${b.roaster || '精品烘焙'} • ${b.origin || '原產地'} (${b.process})</p>
            </div>
            <div class="text-right shrink-0">
              <span class="text-xs font-black font-title text-pinkapp-600 block">${b.weight} g</span>
              <span class="text-[9px] text-pinkapp-400 font-semibold">${b.price ? '$'+b.price : ''}</span>
            </div>
          </div>

          ${b.notes ? `
            <div class="flex flex-wrap gap-1">
              ${b.notes.split(',').map(n => `<span class="bg-pinkapp-50 text-pinkapp-700 text-[9px] font-bold px-2 py-0.5 rounded-lg border border-pinkapp-200/50">🌸 ${n.trim()}</span>`).join('')}
            </div>
          ` : ''}

          <div class="flex justify-between items-center pt-2 border-t border-pinkapp-100 text-[11px]">
            <div class="flex gap-2">
              <button onclick="deductBeanWeight('${b.id}', 15)" class="bg-pinkapp-100 hover:bg-pinkapp-200 text-pinkapp-700 font-bold px-2.5 py-1 rounded-xl text-[10px] transition-all">
                -15g 沖煮
              </button>
              <button onclick="openBeanModal('${b.id}')" class="bg-pinkapp-50 hover:bg-pinkapp-100 text-pinkapp-600 font-bold px-2 py-1 rounded-xl text-[10px]">
                <i data-lucide="edit-2" class="w-3 h-3 inline"></i> 編輯
              </button>
            </div>
            <button onclick="deleteBean('${b.id}')" class="text-pinkapp-300 hover:text-rose-500 transition-colors p-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        </div>
      `).join('');
      lucide.createIcons();
    }

