    let beans = loadStorageData('beans', defaultBeans);
    let brews = loadStorageData('brews', defaultBrews);
    let gears = loadStorageData('gears', defaultGears);

    function loadStorageData(key, fallback) {
      const stored = localStorage.getItem('brewcraft_vbean_38_' + key);
      if (!stored) {
        localStorage.setItem('brewcraft_vbean_38_' + key, JSON.stringify(fallback));
        return fallback;
      }
      try {
        return JSON.parse(stored);
      } catch (e) {
        return fallback;
      }
    }

    function saveStorageData(key, data) {
      localStorage.setItem('brewcraft_vbean_38_' + key, JSON.stringify(data));
      syncToSupabase(key, data);
    }

    // --- SUPABASE & REALTIME IMPLEMENTATION ---
    function initSupabase() {
      const url = localStorage.getItem('brewcraft_sb_url');
      const key = localStorage.getItem('brewcraft_sb_key');
      if (url && key && window.supabase) {
        try {
          supabaseClient = window.supabase.createClient(url, key);
          subscribeRealtime();
        } catch (err) {
          console.warn('Supabase Init Error:', err);
        }
      }
    }

    function subscribeRealtime() {
      if (!supabaseClient) return;
      supabaseClient
        .channel('public-coffee-sync')
        .on('postgres_changes', { event: '*', schema: 'public' }, (payload) => {
          showToast('⚡ 雲端資料已即時更新！');
          fetchFromSupabase();
        })
        .subscribe();
    }

    async function syncToSupabase(key, data) {
      if (!supabaseClient) return;
      try {
        await supabaseClient.from('coffee_app_store').upsert({ id: key, payload: data });
      } catch (err) {
        console.error('Supabase Sync Error:', err);
      }
    }

    async function fetchFromSupabase() {
      if (!supabaseClient) return;
      try {
        const { data, error } = await supabaseClient.from('coffee_app_store').select('*');
        if (data && !error) {
          data.forEach(item => {
            if (item.id === 'beans') beans = item.payload;
            if (item.id === 'brews') brews = item.payload;
            if (item.id === 'gears') gears = item.payload;
            localStorage.setItem('brewcraft_vbean_38_' + item.id, JSON.stringify(item.payload));
          });
          refreshCurrentView();
        }
      } catch (err) {
        console.warn('Supabase fetch failed:', err);
      }
    }

    function openKeyModal() {
      document.getElementById('input-sb-url').value = localStorage.getItem('brewcraft_sb_url') || '';
      document.getElementById('input-sb-key').value = localStorage.getItem('brewcraft_sb_key') || '';
      openModal('modal-key');
    }

    function saveKeysForm(e) {
      e.preventDefault();
      const url = document.getElementById('input-sb-url').value.trim();
      const key = document.getElementById('input-sb-key').value.trim();
      localStorage.setItem('brewcraft_sb_url', url);
      localStorage.setItem('brewcraft_sb_key', key);
      initSupabase();
      closeModal('modal-key');
      showToast('🔑 Supabase 即時同步設定成功！');
    }

    // Toast Notification Banner
    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.textContent = msg;
      toast.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
      }, 2500);
    }

    function navigateTo(targetView) {
      currentView = targetView;
      const views = ['home', 'beans', 'brews', 'gear', 'discover'];
      views.forEach(v => {
        const el = document.getElementById(v === 'home' ? 'view-home' : 'tab-' + v);
        if (el) el.classList.add('hidden');
      });

      const targetEl = document.getElementById(targetView === 'home' ? 'view-home' : 'tab-' + targetView);
      if (targetEl) targetEl.classList.remove('hidden');

      const backBtn = document.getElementById('global-back-btn');
      const headerTitle = document.getElementById('header-title');
      const headerSubtitle = document.getElementById('header-subtitle');
      const quickBtnText = document.getElementById('quick-add-btn-text');

      if (targetView === 'home') {
        backBtn.classList.add('hidden');
        headerTitle.innerHTML = `BrewCraft ✨ <span class="text-[9px] font-sans font-black uppercase tracking-widest bg-pinkapp-500 text-white px-2 py-0.5 rounded-full shadow-sm">Gen Alpha</span>`;
        headerSubtitle.textContent = '🌸 Pink Aesthetic Coffee Stash';
        quickBtnText.textContent = '新增紀錄';
      } else {
        backBtn.classList.remove('hidden');
        if (targetView === 'beans') {
          headerTitle.innerHTML = `粉紅豆櫃庫存 <span class="text-[10px] text-pinkapp-600 font-sans font-bold">(${beans.length})</span>`;
          headerSubtitle.textContent = '返回首頁 ➔ 特選咖啡豆單';
          quickBtnText.textContent = '新增咖啡豆';
        } else if (targetView === 'brews') {
          headerTitle.innerHTML = `黃金比例與日誌`;
          headerSubtitle.textContent = '返回首頁 ➔ 沖煮淬鍊歷程';
          quickBtnText.textContent = '新增日誌';
        } else if (targetView === 'gear') {
          headerTitle.innerHTML = `咖啡裝備與研磨卡`;
          headerSubtitle.textContent = '返回首頁 ➔ 裝備與刻度';
          quickBtnText.textContent = '新增裝備';
        } else if (targetView === 'discover') {
          headerTitle.innerHTML = `特選新豆推薦`;
          headerSubtitle.textContent = '返回首頁 ➔ 探索名店嚴選';
          quickBtnText.textContent = '探索新豆';
        }
      }

      navButtonsUpdate(targetView);
      refreshCurrentView();
      document.getElementById('main-content').scrollTop = 0;
    }

    function navButtonsUpdate(targetView) {
      const navButtons = ['home', 'beans', 'brews', 'gear', 'discover'];
      navButtons.forEach(b => {
        const btn = document.getElementById('nav-btn-' + b);
        if (btn) {
          btn.className = b === targetView 
            ? "nav-item flex flex-col items-center gap-0.5 text-pinkapp-600 font-bold py-1 px-2"
            : "nav-item flex flex-col items-center gap-0.5 text-pinkapp-300 hover:text-pinkapp-600 transition-colors py-1 px-2 font-bold";
        }
      });
    }

    function refreshCurrentView() {
      lucide.createIcons();
      updateHomeStats();
      renderBeansList();
      renderBrewsList();
      renderGearList();
      renderDiscoveriesList();
      populateBeanOptions();
    }

    function handleHeaderQuickAdd() {
      if (currentView === 'beans' || currentView === 'home') openBeanModal();
      else if (currentView === 'brews') openBrewModal();
      else if (currentView === 'gear') openGearModal();
      else if (currentView === 'discover') showToast('請點擊下方推薦豆單嘅「+ 加入豆櫃」即可收藏！🌸');
