      if (card) card.classList.remove('translate-y-full');
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      const card = document.getElementById(id + '-card');
      if (card) card.classList.add('translate-y-full');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    function openBeanModal(id = null) {
      const form = document.getElementById('form-bean');
      form.reset();
      if (id) {
        const b = beans.find(x => x.id === id);
        if (b) {
          document.getElementById('bean-id').value = b.id;
          document.getElementById('input-bean-name').value = b.name;
          document.getElementById('input-bean-roaster').value = b.roaster || '';
          document.getElementById('input-bean-origin').value = b.origin || '';
          document.getElementById('input-bean-process').value = b.process || '水洗 Washed';
          document.getElementById('input-bean-roast').value = b.roast || '淺度烘焙 Light';
          document.getElementById('input-bean-weight').value = b.weight;
          document.getElementById('input-bean-date').value = b.date || '';
          document.getElementById('input-bean-price').value = b.price || '';
          document.getElementById('input-bean-notes').value = b.notes || '';
          document.getElementById('modal-bean-title').textContent = '🌸 編輯咖啡豆資料';
        }
      } else {
        document.getElementById('bean-id').value = '';
        document.getElementById('modal-bean-title').textContent = '🌸 新增咖啡豆至粉紅豆櫃';
      }
      openModal('modal-bean');
    }

    // CONFIRM KEY FIX: Form Submission Handler
    function saveBeanForm(e) {
      e.preventDefault();
      const id = document.getElementById('bean-id').value;
      const beanData = {
        id: id || 'b_' + Date.now(),
        name: document.getElementById('input-bean-name').value.trim(),
        roaster: document.getElementById('input-bean-roaster').value.trim(),
        origin: document.getElementById('input-bean-origin').value.trim(),
        process: document.getElementById('input-bean-process').value,
        roast: document.getElementById('input-bean-roast').value,
        weight: Number(document.getElementById('input-bean-weight').value),
        date: document.getElementById('input-bean-date').value,
        price: document.getElementById('input-bean-price').value,
        notes: document.getElementById('input-bean-notes').value.trim(),
        flavor: {
          aroma: document.getElementById('flavor-aroma').value,
          acidity: document.getElementById('flavor-acidity').value,
          sweetness: document.getElementById('flavor-sweetness').value,
          body: document.getElementById('flavor-body').value,
          finish: document.getElementById('flavor-finish').value,
        }
      };

      if (id) {
        const idx = beans.findIndex(x => x.id === id);
        if (idx !== -1) beans[idx] = beanData;
      } else {
        beans.unshift(beanData);
      }

      saveStorageData('beans', beans);
      closeModal('modal-bean');
      showToast(id ? '✨ 咖啡豆更新成功！' : '💖 新咖啡豆已入櫃！');
      refreshCurrentView();
    }

    function deductBeanWeight(id, amount) {
      const b = beans.find(x => x.id === id);
      if (b) {
        b.weight = Math.max(0, b.weight - amount);
        saveStorageData('beans', beans);
        showToast(`已扣減 ${amount}g 豆量！剩餘 ${b.weight}g`);
        refreshCurrentView();
      }
    }

    function deleteBean(id) {
      if (confirm('確定要刪除這款咖啡豆？')) {
        beans = beans.filter(x => x.id !== id);
        saveStorageData('beans', beans);
        showToast('已移除咖啡豆');
        refreshCurrentView();
      }
    }

    // BREWS LOGIC
    function openBrewModal() {
      document.getElementById('form-brew').reset();
      populateBeanOptions();
      autoCalcRatio();
      renderStarRating(5);
      openModal('modal-brew');
    }

    function populateBeanOptions() {
      const select1 = document.getElementById('input-brew-bean');
      const select2 = document.getElementById('recommend-bean-select');
      const options = beans.map(b => `<option value="${b.id}">${b.name} (${b.weight}g)</option>`).join('');
      if (select1) select1.innerHTML = options || '<option value="">無現存咖啡豆</option>';
      if (select2) select2.innerHTML = options || '<option value="">無現存咖啡豆</option>';
      generateBrewRecommendation();
    }

    function autoCalcRatio() {
      const dose = parseFloat(document.getElementById('input-brew-dose').value) || 0;
      const water = parseFloat(document.getElementById('input-brew-water').value) || 0;
      if (dose > 0 && water > 0) {
        const ratio = (water / dose).toFixed(1);
        document.getElementById('input-brew-ratio').value = `1:${ratio}`;
      }
    }

    function renderStarRating(score) {
      selectedStarScore = score;
      document.getElementById('input-brew-score').value = score;
      const container = document.getElementById('brew-star-rating');
      container.innerHTML = [1,2,3,4,5].map(i => `
        <i data-lucide="star" onclick="renderStarRating(${i})" class="w-6 h-6 cursor-pointer ${i <= score ? 'fill-pinkapp-500 text-pinkapp-500' : 'text-pinkapp-200'} transition-all"></i>
      `).join('');
      lucide.createIcons();
    }

    function saveBrewForm(e) {
      e.preventDefault();
      const beanId = document.getElementById('input-brew-bean').value;
      const selectedBean = beans.find(b => b.id === beanId);
      const dose = Number(document.getElementById('input-brew-dose').value);

      const brewData = {
        id: 'br_' + Date.now(),
        beanId: beanId,
        beanName: selectedBean ? selectedBean.name : '未知咖啡豆',
        method: document.getElementById('input-brew-method').value,
        grind: document.getElementById('input-brew-grind').value,
        dose: dose,
        water: Number(document.getElementById('input-brew-water').value),
        temp: document.getElementById('input-brew-temp').value,
        ratio: document.getElementById('input-brew-ratio').value,
        score: Number(document.getElementById('input-brew-score').value),
        notes: document.getElementById('input-brew-notes').value.trim(),
        timestamp: new Date().toLocaleString()
      };

      brews.unshift(brewData);
      saveStorageData('brews', brews);

      if (selectedBean) {
        deductBeanWeight(beanId, dose);
      }

      closeModal('modal-brew');
      showToast('✨ 沖煮日誌保存成功！');
      refreshCurrentView();
    }

    function renderBrewsList() {
      const container = document.getElementById('brews-list-container');
      if (!container) return;
      const search = (document.getElementById('brew-search-input')?.value || '').toLowerCase().trim();
      
      let filtered = brews.filter(b => b.beanName.toLowerCase().includes(search) || (b.notes && b.notes.toLowerCase().includes(search)));
      document.getElementById('brew-count-badge').textContent = filtered.length;

      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white border border-pinkapp-200 rounded-3xl p-6 text-center text-xs text-pinkapp-400">尚無相關沖煮紀錄 ☕</div>`;
        return;
      }

      container.innerHTML = filtered.map(b => `
        <div class="bg-white border border-pinkapp-200/80 rounded-3xl p-4 shadow-soft-card space-y-2 relative">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-[9px] font-black text-rose-500 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-100">${b.method} • ${b.ratio}</span>
              <h3 class="text-xs font-bold font-title text-pinkapp-900 mt-1">${b.beanName}</h3>
            </div>
            <div class="text-right">
              <span class="text-xs text-pinkapp-500 font-bold">${'★'.repeat(b.score)}</span>
              <span class="text-[9px] text-pinkapp-400 font-medium block">${b.timestamp}</span>
            </div>
          </div>
          <div class="grid grid-cols-3 gap-1 bg-pinkapp-50/50 p-2 rounded-xl text-[10px] font-bold text-pinkapp-800 text-center">
            <div>粉量: ${b.dose}g</div>
            <div>水量: ${b.water}g</div>
            <div>水溫: ${b.temp}°C</div>
          </div>
          ${b.notes ? `<p class="text-[10px] text-pinkapp-700 bg-pinkapp-50/30 p-2 rounded-xl border border-pinkapp-100/50">${b.notes}</p>` : ''}
        </div>
      `).join('');
    }

    function generateBrewRecommendation() {
      const select = document.getElementById('recommend-bean-select');
      const container = document.getElementById('recommendation-result');
      if (!select || !container) return;

      const bean = beans.find(b => b.id === select.value);
      if (!bean) {
        container.innerHTML = `<p class="text-center text-pink-100">請先新增咖啡豆至豆櫃 🌸</p>`;
        return;
      }

      let ratio = "1:16";
      let temp = "92°C";
      let grind = "中細研磨 (EK43 8.0 / C40 24咔)";

      if (bean.roast.includes('淺')) { ratio = "1:15.5"; temp = "93°C - 94°C"; }
      else if (bean.roast.includes('深')) { ratio = "1:14.0"; temp = "86°C - 88°C"; }

      container.innerHTML = `
        <div class="grid grid-cols-3 gap-2 text-center font-bold">
          <div class="bg-white/20 p-1.5 rounded-xl">黃金比: ${ratio}</div>
          <div class="bg-white/20 p-1.5 rounded-xl">建議水溫: ${temp}</div>
          <div class="bg-white/20 p-1.5 rounded-xl">粉量: 15g ➔ 240g</div>
        </div>
        <p class="text-[10px] text-pink-100 font-medium text-center">💡 建議刻度: ${grind}</p>
      `;
    }

    // GEAR MANAGEMENT
    function openGearModal() {
      document.getElementById('form-gear').reset();
      openModal('modal-gear');
    }

    function setGearFilter(f) {
      gearFilter = f;
      document.querySelectorAll('.gear-filter-pill').forEach(btn => {
        btn.className = "gear-filter-pill bg-white border border-pinkapp-200 text-pinkapp-800 px-3 py-1 rounded-xl text-[11px] font-bold transition-all";
      });
      const active = document.getElementById('gear-filter-' + f);
      if (active) active.className = "gear-filter-pill active bg-pinkapp-600 text-white px-3 py-1 rounded-xl text-[11px] font-bold transition-all";
      renderGearList();
    }

    function saveGearForm(e) {
      e.preventDefault();
      const gearData = {
        id: 'g_' + Date.now(),
        name: document.getElementById('input-gear-name').value.trim(),
        type: document.getElementById('input-gear-type').value,
        brand: document.getElementById('input-gear-brand').value.trim(),
        settingNote: document.getElementById('input-gear-note').value.trim()
      };
      gears.unshift(gearData);
      saveStorageData('gears', gears);
      closeModal('modal-gear');
      showToast('🌸 新裝備已加入清單！');
      refreshCurrentView();
    }

    function renderGearList() {
      const container = document.getElementById('gear-list-container');
      if (!container) return;
      let filtered = gears.filter(g => gearFilter === 'ALL' || g.type === gearFilter);

      if (filtered.length === 0) {
        container.innerHTML = `<div class="bg-white border border-pinkapp-200 rounded-3xl p-6 text-center text-xs text-pinkapp-400">未有相關裝備紀錄 🔧</div>`;
        return;
      }

      container.innerHTML = filtered.map(g => `
        <div class="bg-white border border-pinkapp-200/80 rounded-3xl p-4 shadow-soft-card space-y-2">
          <div class="flex justify-between items-center">
            <span class="text-[9px] font-black uppercase text-fuchsia-600 bg-fuchsia-50 px-2 py-0.5 rounded-md border border-fuchsia-100">${g.type}</span>
            <span class="text-[10px] font-bold text-pinkapp-400">${g.brand || ''}</span>
          </div>
          <h3 class="text-xs font-bold font-title text-pinkapp-900">${g.name}</h3>
          ${g.settingNote ? `<p class="text-[10px] text-pinkapp-700 bg-pinkapp-50/50 p-2 rounded-xl border border-pinkapp-100 font-medium">${g.settingNote}</p>` : ''}
        </div>
      `).join('');
    }

    // DISCOVERY MANAGEMENT
    function renderDiscoveriesList() {
      const container = document.getElementById('discovery-list-container');
      if (!container) return;
      container.innerHTML = discoveryBeans.map(d => `
        <div class="bg-white border border-pinkapp-200/80 rounded-3xl p-4 shadow-soft-card space-y-2">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-[9px] font-black text-purple-600 bg-purple-50 px-2 py-0.5 rounded-md border border-purple-100">${d.roaster}</span>
              <h3 class="text-xs font-bold font-title text-pinkapp-900 mt-1">${d.name}</h3>
            </div>
            <span class="text-xs font-bold text-pinkapp-600">$${d.price}</span>
          </div>
          <p class="text-[10px] text-pinkapp-600 font-medium leading-relaxed">${d.description}</p>
          <div class="flex justify-between items-center pt-2">
            <span class="text-[9px] font-bold text-pinkapp-500">🌸 ${d.notes}</span>
            <button onclick="addDiscoveryToStash('${d.id}')" class="bg-pinkapp-600 hover:bg-pinkapp-700 text-white text-[10px] font-bold px-3 py-1.5 rounded-xl shadow-pink-glow active:scale-95 transition-all">
              + 加入豆櫃
            </button>
          </div>
        </div>
      `).join('');
    }

    function addDiscoveryToStash(id) {
      const item = discoveryBeans.find(d => d.id === id);
      if (!item) return;
      const newBean = {
        id: 'b_' + Date.now(),
        name: item.name,
        roaster: item.roaster,
        origin: item.origin,
        process: item.process,
        roast: item.roast,
        weight: 200,
        date: new Date().toISOString().split('T')[0],
        price: item.price,
        notes: item.notes,
        flavor: { aroma: 4.8, acidity: 4.5, sweetness: 4.5, body: 3.5, finish: 4.5 }
      };
      beans.unshift(newBean);
      saveStorageData('beans', beans);
      showToast('💖 已成功將新豆加入粉紅豆櫃！');
      navigateTo('beans');
    }

    // TIMER SYSTEM
    let timerInterval = null;
    let timerSeconds = 0;
    let isTimerRunning = false;

    function openTimerModal() {
      resetBrewTimer();
      openModal('modal-timer');
    }

    function toggleBrewTimer() {
      const playIcon = document.getElementById('timer-play-icon');
      if (isTimerRunning) {
        clearInterval(timerInterval);
        isTimerRunning = false;
        if (playIcon) playIcon.setAttribute('data-lucide', 'play');
      } else {
        isTimerRunning = true;
        if (playIcon) playIcon.setAttribute('data-lucide', 'pause');
        timerInterval = setInterval(() => {
          timerSeconds++;
          updateTimerUI();
        }, 1000);
      }
      lucide.createIcons();
    }

    function resetBrewTimer() {
      clearInterval(timerInterval);
      isTimerRunning = false;
      timerSeconds = 0;
      updateTimerUI();
      const playIcon = document.getElementById('timer-play-icon');
      if (playIcon) playIcon.setAttribute('data-lucide', 'play');
      lucide.createIcons();
    }

    function updateTimerUI() {
      const mins = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
      const secs = String(timerSeconds % 60).padStart(2, '0');
      document.getElementById('timer-display').textContent = `${mins}:${secs}`;

      const badge = document.getElementById('timer-stage-badge');
      const instruction = document.getElementById('timer-instruction');
      const progressBar = document.getElementById('timer-progress-bar');

      let progress = Math.min(100, (timerSeconds / 150) * 100);
      if (progressBar) progressBar.style.width = `${progress}%`;

      if (timerSeconds === 0) {
        badge.textContent = '🌸 準備 Ready';
        instruction.textContent = '點擊粉紅按鈕開啟悶蒸階段 ✨';
      } else if (timerSeconds <= 30) {
        badge.textContent = '🌸 悶蒸 Bloom (30s)';
        instruction.textContent = '注入約 30-40g 熱水，等待咖啡粉膨脹釋放香氣';
      } else if (timerSeconds <= 90) {
        badge.textContent = '💧 第一段注水 Pour 1';
        instruction.textContent = '由內向外順時針繞圈注入至 140g 熱水';
      } else if (timerSeconds <= 150) {
        badge.textContent = '✨ 尾段萃取 Pour 2';
        instruction.textContent = '中心大水流補水至目標 240g，等待濾乾完成';
      } else {
        badge.textContent = '💖 萃取完成 Complete';
        instruction.textContent = '享受你嘅 Perfect Pink Coffee！✨';
      }
    }

    // App Initialization
    window.addEventListener('DOMContentLoaded', () => {
      initSupabase();
      refreshCurrentView();
    });
  </script>
</body>
</html>
