<!DOCTYPE html>
<html lang="zh-HK" class="h-full bg-[#FDF2F8] text-[#3D001E]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>BrewCraft ✨ Pink Coffee Journal & Calculator</title>
  
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Google Fonts: Plus Jakarta Sans & Fredoka -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            title: ['Fredoka', 'system-ui', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'system-ui', 'sans-serif'],
          },
          colors: {
            pinkapp: {
              50: '#FFF0F5',   // Lavender blush
              100: '#FCE7F3',  // Light cotton pink
              200: '#FBCFE8',  // Soft pink accent
              300: '#F472B6',  // Bubblegum pink
              400: '#F172AC',  // Warm rose
              500: '#EC4899',  // Vibrant pink primary
              600: '#DB2777',  // Deep hot pink
              700: '#BE185D',  // Magenta dark
              800: '#831843',  // Plum maroon
              900: '#3D001E',  // Dark espresso pink text
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background-color: #FDF2F8;
      color: #3D001E;
      -webkit-tap-highlight-color: transparent;
    }

    .font-title {
      font-family: 'Fredoka', cursive, sans-serif;
    }

    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(252, 231, 243, 0.6);
    }
    ::-webkit-scrollbar-thumb {
      background: #F472B6;
      border-radius: 9999px;
    }

    .shadow-pink-glow {
      box-shadow: 0 10px 28px -6px rgba(236, 72, 153, 0.35), 0 4px 12px -2px rgba(219, 39, 119, 0.15);
    }
    .shadow-soft-card {
      box-shadow: 0 8px 24px -4px rgba(236, 72, 153, 0.08), 0 2px 8px -1px rgba(0, 0, 0, 0.03);
    }

    input[type=range] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 18px;
      width: 18px;
      border-radius: 50%;
      background: #EC4899;
      cursor: pointer;
      margin-top: -6px;
      box-shadow: 0 2px 8px rgba(236, 72, 153, 0.5);
      border: 2px solid #FFFFFF;
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 6px;
      cursor: pointer;
      background: #FBCFE8;
      border-radius: 9999px;
    }
    
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .view-transition {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>
<body class="h-full flex justify-center items-center p-0 sm:p-4 md:p-6 overflow-hidden select-none">

  <!-- Mobile Frame Container -->
  <div class="w-full h-full sm:max-w-md sm:h-[844px] bg-[#FDF2F8] sm:rounded-[44px] border-0 sm:border-[8px] sm:border-pinkapp-300/40 shadow-2xl flex flex-col relative overflow-hidden">

    <!-- Top Status Bar Mockup -->
    <div class="hidden sm:flex items-center justify-between px-7 pt-3 pb-1 text-xs text-pinkapp-800/70 z-20 bg-[#FDF2F8]/90 backdrop-blur-md">
      <span class="font-bold tracking-tight" id="clock-display">09:41</span>
      <div class="w-20 h-4 bg-pinkapp-300/30 rounded-full mx-auto my-0"></div>
      <div class="flex items-center space-x-1.5 text-pinkapp-600">
        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
        <i data-lucide="wifi" class="w-3.5 h-3.5"></i>
        <i data-lucide="battery-charging" class="w-4 h-4"></i>
      </div>
    </div>

    <!-- Application Top Navigation Bar -->
    <header class="bg-white/90 backdrop-blur-md border-b border-pinkapp-200/60 px-4 py-3 flex items-center justify-between z-10 sticky top-0 transition-all">
      <div class="flex items-center space-x-2.5">
        <button 
          id="global-back-btn" 
          onclick="navigateTo('home')" 
          class="hidden flex items-center justify-center w-9 h-9 rounded-2xl bg-pinkapp-100 hover:bg-pinkapp-200 text-pinkapp-700 transition-all active:scale-95 shadow-sm border border-pinkapp-200/80 mr-0.5"
          title="返回主頁"
        >
          <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </button>

        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-pinkapp-500 to-rose-400 text-white flex items-center justify-center shadow-pink-glow shrink-0">
          <i data-lucide="heart-handshake" class="w-5 h-5 stroke-[2.2]"></i>
        </div>
        <div>
          <h1 id="header-title" class="text-base font-extrabold font-title tracking-wide text-pinkapp-900 flex items-center gap-1.5 leading-tight">
            BrewCraft ✨
            <span class="text-[9px] font-sans font-black uppercase tracking-widest bg-pinkapp-500 text-white px-2 py-0.5 rounded-full shadow-sm">Gen Alpha</span>
          </h1>
          <p id="header-subtitle" class="text-[10px] text-pinkapp-600 font-semibold leading-none mt-0.5">🌸 Pink Aesthetic Coffee Stash</p>
        </div>
      </div>

      <div class="flex items-center gap-1.5">
        <!-- Key / Supabase Config Button -->
        <button 
          onclick="openKeyModal()" 
          class="p-2 rounded-2xl bg-pinkapp-100 hover:bg-pinkapp-200 text-pinkapp-700 transition-all active:scale-95 border border-pinkapp-200/80"
          title="設定 Supabase Key 與即時同步"
        >
          <i data-lucide="key-round" class="w-4 h-4"></i>
        </button>
        <button 
          onclick="handleHeaderQuickAdd()" 
          class="flex items-center gap-1 bg-gradient-to-r from-pinkapp-500 via-rose-500 to-pinkapp-600 hover:from-pinkapp-600 hover:to-rose-600 text-white font-bold px-3 py-1.5 rounded-2xl text-xs transition-all shadow-pink-glow active:scale-95"
        >
          <i data-lucide="plus" class="w-4 h-4 stroke-[3]"></i>
          <span id="quick-add-btn-text">新增紀錄</span>
        </button>
      </div>
    </header>

    <!-- Global Floating Toast Notification -->
    <div id="toast" class="absolute top-16 left-1/2 -translate-x-1/2 z-50 bg-gradient-to-r from-pinkapp-600 to-rose-500 text-white text-xs font-bold px-4 py-2.5 rounded-2xl shadow-pink-glow border border-white/30 flex items-center gap-2 opacity-0 -translate-y-4 pointer-events-none transition-all duration-300">
      <i data-lucide="sparkles" class="w-4 h-4 text-pinkapp-100"></i>
      <span id="toast-msg">Slay! 操作成功 💖</span>
    </div>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 overflow-y-auto pb-24 px-4 py-4 relative space-y-4">

      <!-- VIEW 0: HOME PORTAL -->
      <section id="view-home" class="space-y-4 view-transition">
        <div class="bg-gradient-to-br from-pinkapp-500 via-rose-500 to-pinkapp-600 text-white rounded-3xl p-5 shadow-pink-glow relative overflow-hidden">
          <div class="absolute -right-8 -bottom-8 w-36 h-36 bg-white/20 rounded-full blur-2xl pointer-events-none"></div>
          <div class="flex justify-between items-start relative z-10">
            <div>
              <span class="text-[10px] font-black text-pinkapp-100 uppercase tracking-widest block mb-1">💖 Main Character Energy</span>
              <h2 class="text-xl font-black font-title tracking-wide text-white">Hey Bestie! ☕✨</h2>
              <p class="text-xs text-pink-100 font-medium mt-1 max-w-[240px]">歡迎來到專屬你嘅粉紅咖啡靈感空間。</p>
            </div>
            <div class="p-2.5 bg-white/20 backdrop-blur-md rounded-2xl border border-white/30 text-center shadow-sm">
              <i data-lucide="sparkles" class="w-6 h-6 text-pink-100 mx-auto mb-0.5"></i>
              <span class="text-[9px] text-white block font-bold">10/10 Vibe</span>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 mt-4 pt-3 border-t border-white/20 relative z-10">
            <div class="bg-white/15 backdrop-blur-sm p-2 rounded-2xl text-center border border-white/20">
              <span class="text-[9px] text-pink-100 font-bold block">💖 豆櫃存量</span>
              <span id="home-stat-beans" class="text-sm font-extrabold font-title text-white">0 款</span>
            </div>
            <div class="bg-white/15 backdrop-blur-sm p-2 rounded-2xl text-center border border-white/20">
              <span class="text-[9px] text-pink-100 font-bold block">✨ 沖煮次數</span>
              <span id="home-stat-brews" class="text-sm font-extrabold font-title text-white">0 次</span>
            </div>
            <div class="bg-white/15 backdrop-blur-sm p-2 rounded-2xl text-center border border-white/20">
              <span class="text-[9px] text-pink-100 font-bold block">🌸 器材數量</span>
              <span id="home-stat-gears" class="text-sm font-extrabold font-title text-white">0 件</span>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center px-1">
            <h3 class="text-xs font-black text-pinkapp-900 uppercase tracking-widest flex items-center gap-1.5">
              <i data-lucide="layout-grid" class="w-4 h-4 text-pinkapp-500"></i> 功能選單 • Menu
            </h3>
            <span class="text-[10px] text-pinkapp-600 font-semibold">一鍵切換頁面</span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <button onclick="navigateTo('beans')" class="group bg-white hover:bg-pinkapp-50 border border-pinkapp-200/80 rounded-3xl p-4 text-left transition-all shadow-soft-card hover:shadow-pink-glow flex flex-col justify-between h-32 relative overflow-hidden active:scale-[0.98]">
              <div class="flex justify-between items-start">
                <div class="w-9 h-9 rounded-2xl bg-pinkapp-100 text-pinkapp-600 flex items-center justify-center group-hover:bg-pinkapp-500 group-hover:text-white transition-colors">
                  <i data-lucide="archive" class="w-5 h-5"></i>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-pinkapp-300 group-hover:text-pinkapp-500 group-hover:translate-x-0.5 transition-all"></i>
              </div>
              <div>
                <span class="text-[10px] font-black text-pinkapp-500 uppercase tracking-wider block">1. 粉紅豆櫃</span>
                <h4 class="text-sm font-bold font-title text-pinkapp-900 group-hover:text-pinkapp-600 transition-colors">咖啡豆庫存與風味</h4>
                <p class="text-[10px] text-pinkapp-600/70 line-clamp-1 font-medium">克數追蹤、5維風味評分</p>
              </div>
            </button>

            <button onclick="navigateTo('brews')" class="group bg-white hover:bg-pinkapp-50 border border-pinkapp-200/80 rounded-3xl p-4 text-left transition-all shadow-soft-card hover:shadow-pink-glow flex flex-col justify-between h-32 relative overflow-hidden active:scale-[0.98]">
              <div class="flex justify-between items-start">
                <div class="w-9 h-9 rounded-2xl bg-rose-100 text-rose-500 flex items-center justify-center group-hover:bg-rose-500 group-hover:text-white transition-colors">
                  <i data-lucide="coffee" class="w-5 h-5"></i>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-pinkapp-300 group-hover:text-rose-500 group-hover:translate-x-0.5 transition-all"></i>
              </div>
              <div>
                <span class="text-[10px] font-black text-rose-500 uppercase tracking-wider block">2. 沖泡日誌</span>
                <h4 class="text-sm font-bold font-title text-pinkapp-900 group-hover:text-rose-600 transition-colors">黃金比例與手沖日誌</h4>
                <p class="text-[10px] text-pinkapp-600/70 line-clamp-1 font-medium">粉水比演算與星級評價</p>
              </div>
            </button>

            <button onclick="navigateTo('gear')" class="group bg-white hover:bg-pinkapp-50 border border-pinkapp-200/80 rounded-3xl p-4 text-left transition-all shadow-soft-card hover:shadow-pink-glow flex flex-col justify-between h-32 relative overflow-hidden active:scale-[0.98]">
              <div class="flex justify-between items-start">
                <div class="w-9 h-9 rounded-2xl bg-fuchsia-100 text-fuchsia-600 flex items-center justify-center group-hover:bg-fuchsia-500 group-hover:text-white transition-colors">
                  <i data-lucide="wrench" class="w-5 h-5"></i>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-pinkapp-300 group-hover:text-fuchsia-500 group-hover:translate-x-0.5 transition-all"></i>
              </div>
              <div>
                <span class="text-[10px] font-black text-fuchsia-600 uppercase tracking-wider block">3. 裝備清單</span>
                <h4 class="text-sm font-bold font-title text-pinkapp-900 group-hover:text-fuchsia-600 transition-colors">磨豆機與器具備忘</h4>
                <p class="text-[10px] text-pinkapp-600/70 line-clamp-1 font-medium">刻度記錄與保養卡</p>
              </div>
            </button>

            <button onclick="navigateTo('discover')" class="group bg-white hover:bg-pinkapp-50 border border-pinkapp-200/80 rounded-3xl p-4 text-left transition-all shadow-soft-card hover:shadow-pink-glow flex flex-col justify-between h-32 relative overflow-hidden active:scale-[0.98]">
              <div class="flex justify-between items-start">
                <div class="w-9 h-9 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center group-hover:bg-purple-500 group-hover:text-white transition-colors">
                  <i data-lucide="sparkles" class="w-5 h-5"></i>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-pinkapp-300 group-hover:text-purple-500 group-hover:translate-x-0.5 transition-all"></i>
              </div>
              <div>
                <span class="text-[10px] font-black text-purple-600 uppercase tracking-wider block">4. 靈感新豆</span>
                <h4 class="text-sm font-bold font-title text-pinkapp-900 group-hover:text-purple-600 transition-colors">名店嚴選熱門豆單</h4>
                <p class="text-[10px] text-pinkapp-600/70 line-clamp-1 font-medium">一鍵直接收藏入櫃</p>
              </div>
            </button>
          </div>
        </div>

        <div class="bg-gradient-to-br from-pinkapp-100 via-pink-50 to-white border border-pinkapp-200 rounded-3xl p-4 shadow-soft-card flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-pinkapp-500 to-rose-500 text-white flex items-center justify-center shadow-pink-glow shrink-0">
              <i data-lucide="timer" class="w-5 h-5"></i>
            </div>
            <div>
              <h4 class="text-xs font-bold text-pinkapp-900 font-title">🌸 3段手沖金杯計時器</h4>
              <p class="text-[10px] text-pinkapp-600 font-medium">悶蒸 30s ➔ 第一段 ➔ 尾段萃取</p>
            </div>
          </div>
          <button onclick="openTimerModal()" class="bg-pinkapp-600 hover:bg-pinkapp-700 text-white font-bold px-3.5 py-2 rounded-2xl text-xs transition-all shadow-pink-glow flex items-center gap-1 active:scale-95 shrink-0">
            啟動計時
          </button>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center px-1">
            <h3 class="text-xs font-black text-pinkapp-900 uppercase tracking-widest flex items-center gap-1.5">
              <i data-lucide="history" class="w-4 h-4 text-pinkapp-500"></i> 最近淬鍊日誌
            </h3>
            <button onclick="navigateTo('brews')" class="text-[11px] font-bold text-pinkapp-600 hover:underline">查看全部 ✨</button>
          </div>

          <div id="home-recent-brews-container" class="space-y-2">
            <!-- Dynamically populated -->
          </div>
        </div>
      </section>

      <!-- SECTION 1: 豆櫃管理 -->
      <section id="tab-beans" class="space-y-4 hidden view-transition">
        <div class="bg-gradient-to-br from-white via-pinkapp-50 to-pinkapp-100/60 border border-pinkapp-200/80 rounded-3xl p-4 shadow-soft-card space-y-3 relative overflow-hidden">
          <div class="flex justify-between items-center relative z-10">
            <div>
              <span class="text-[10px] font-black text-pinkapp-500 uppercase tracking-widest">💖 Pink Bean Stash</span>
              <h2 class="text-base font-bold font-title text-pinkapp-900">現存特選咖啡豆單</h2>
            </div>
            <button onclick="openBeanModal()" class="text-xs bg-pinkapp-600 hover:bg-pinkapp-700 text-white font-bold px-3 py-1.5 rounded-2xl transition-all shadow-pink-glow flex items-center gap-1 active:scale-95">
              <i data-lucide="plus" class="w-4 h-4 stroke-[3]"></i> 新增咖啡豆
            </button>
          </div>

          <div class="grid grid-cols-3 gap-2 pt-2 border-t border-pinkapp-200/60 relative z-10">
            <div class="bg-white/80 backdrop-blur-sm p-2 rounded-2xl border border-pinkapp-200/50 text-center">
              <span class="text-[9px] text-pinkapp-600 block font-bold">總豆款</span>
              <span id="stat-bean-count" class="text-sm font-extrabold font-title text-pinkapp-900">0 款</span>
            </div>
            <div class="bg-white/80 backdrop-blur-sm p-2 rounded-2xl border border-pinkapp-200/50 text-center">
              <span class="text-[9px] text-pinkapp-600 block font-bold">總克數</span>
              <span id="stat-bean-weight" class="text-sm font-extrabold font-title text-pinkapp-600">0 g</span>
            </div>
            <div class="bg-white/80 backdrop-blur-sm p-2 rounded-2xl border border-pinkapp-200/50 text-center">
              <span class="text-[9px] text-pinkapp-600 block font-bold">烘焙商</span>
              <span id="stat-bean-roasters" class="text-sm font-extrabold font-title text-pinkapp-900">0 家</span>
            </div>
          </div>
        </div>

        <div class="space-y-2.5">
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-3 text-pinkapp-400"></i>
            <input 
              type="text" 
              id="bean-search-input"
              oninput="renderBeansList()"
              placeholder="搜尋豆名、產地或烘焙商..."
              class="w-full bg-white border border-pinkapp-200 rounded-2xl pl-10 pr-4 py-2 text-xs text-pinkapp-900 placeholder-pinkapp-300 focus:outline-none focus:border-pinkapp-500 shadow-sm transition-all"
            >
          </div>

          <div class="flex items-center justify-between gap-2 overflow-x-auto no-scrollbar py-0.5 text-xs">
            <div class="flex items-center gap-1.5 shrink-0">
              <button onclick="setBeanFilter('ALL')" id="bean-filter-ALL" class="bean-filter-pill active bg-pinkapp-600 text-white px-3 py-1 rounded-xl font-bold text-[11px] transition-all">全部</button>
              <button onclick="setBeanFilter('LIGHT')" id="bean-filter-LIGHT" class="bean-filter-pill bg-white border border-pinkapp-200 text-pinkapp-700 px-3 py-1 rounded-xl font-bold text-[11px] transition-all">淺烘焙</button>
              <button onclick="setBeanFilter('MEDIUM')" id="bean-filter-MEDIUM" class="bean-filter-pill bg-white border border-pinkapp-200 text-pinkapp-700 px-3 py-1 rounded-xl font-bold text-[11px] transition-all">中烘焙</button>
              <button onclick="setBeanFilter('DARK')" id="bean-filter-DARK" class="bean-filter-pill bg-white border border-pinkapp-200 text-pinkapp-700 px-3 py-1 rounded-xl font-bold text-[11px] transition-all">深烘焙</button>
            </div>

            <select id="bean-sort-select" onchange="renderBeansList()" class="bg-white border border-pinkapp-200 text-pinkapp-800 text-[11px] font-bold rounded-xl px-2.5 py-1 focus:outline-none shrink-0 shadow-sm">
              <option value="newest">最新進豆</option>
              <option value="weight-desc">庫存多至今</option>
              <option value="weight-asc">庫存告急</option>
            </select>
          </div>
        </div>

        <div id="beans-list-container" class="space-y-3">
          <!-- Dynamically populated -->
        </div>
      </section>

      <!-- SECTION 2: 沖泡推介與日誌 -->
      <section id="tab-brews" class="space-y-4 hidden view-transition">
        <div class="bg-gradient-to-br from-pinkapp-600 via-rose-500 to-pinkapp-700 text-white rounded-3xl p-4 shadow-pink-glow space-y-3 relative overflow-hidden">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <i data-lucide="sparkles" class="w-4 h-4 text-pink-200"></i>
              <h2 class="text-xs font-black uppercase tracking-widest text-pink-100">Smart Golden Ratio</h2>
            </div>
            <button onclick="openTimerModal()" class="text-[10px] bg-white/20 hover:bg-white/30 border border-white/30 text-white font-bold px-2.5 py-1 rounded-xl flex items-center gap-1 transition-all">
              <i data-lucide="timer" class="w-3 h-3"></i> 啟動計時
            </button>
          </div>
          <div>
            <h3 class="text-base font-bold font-title text-white">🌸 金杯演算手沖推介</h3>
            <p class="text-[11px] text-pink-100 font-medium">選擇豆櫃咖啡豆，自動計算完美粉水比與水溫。</p>
          </div>

          <div class="flex gap-2">
            <select id="recommend-bean-select" onchange="generateBrewRecommendation()" class="flex-1 bg-white/20 border border-white/30 rounded-2xl text-xs text-white p-2 focus:outline-none font-bold">
              <!-- Options populated dynamically -->
            </select>
          </div>

          <div id="recommendation-result" class="bg-white/15 border border-white/25 rounded-2xl p-3 text-xs space-y-2 backdrop-blur-md">
            <!-- Recommendation output dynamically inserted here -->
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between gap-2">
            <div class="relative flex-1">
              <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-2.5 text-pinkapp-400"></i>
              <input 
                type="text" 
                id="brew-search-input"
                oninput="renderBrewsList()"
                placeholder="搜尋歷史紀錄、風味評語..."
