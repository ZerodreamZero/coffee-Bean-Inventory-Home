    function setBeanFilter(filter) {
      beanFilter = filter;
      document.querySelectorAll('.bean-filter-pill').forEach(btn => {
        btn.className = "bean-filter-pill bg-white border border-pinkapp-200 text-pinkapp-700 px-3 py-1 rounded-xl font-bold text-[11px] transition-all";
      });
